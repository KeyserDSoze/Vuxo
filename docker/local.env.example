# Local development only; node scripts/dev.mjs init replaces the secret markers.
# This file is safe to commit. docker/.env.local is private and gitignored.
VUXO_POSTGRES_DB=vuxo
VUXO_POSTGRES_USER=vuxo
VUXO_POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
VUXO_JWT_SIGNING_KEY=GENERATE_JWT_SIGNING_KEY
VUXO_ALLOWED_ORIGIN=http://127.0.0.1:5173

# Host-only loopback ports. Change before starting if another service uses one.
VUXO_API_DEV_PORT=8080
VUXO_FRONTEND_DEV_PORT=5173
VUXO_POSTGRES_DEV_PORT=55432
VUXO_REDIS_DEV_PORT=56379
VUXO_OLLAMA_DEV_PORT=11434

# LLM is opt-in for local development; local services never expose the production tunnel.
VUXO_LLM_ENABLED=false
VUXO_LLM_MODEL=qwen3:1.7b
