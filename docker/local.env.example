# Local development only. node scripts/dev.mjs init writes docker/.env.local with random secrets.
# Never reuse this file for production. All published ports are bound to 127.0.0.1.
VUXO_COMPOSE_PROJECT=vuxo-local
VUXO_API_PORT=8080
VUXO_FRONTEND_PORT=5173
VUXO_POSTGRES_DEV_PORT=5432
VUXO_REDIS_DEV_PORT=6379
VUXO_OLLAMA_DEV_PORT=11434
VUXO_GRAFANA_PORT=3000
VUXO_E2E_PORT=4173
VUXO_POSTGRES_DB=vuxo
VUXO_POSTGRES_USER=vuxo
VUXO_POSTGRES_PASSWORD=GENERATED_BY_INIT
VUXO_JWT_SIGNING_KEY=GENERATED_BY_INIT
VUXO_GRAFANA_ADMIN_PASSWORD=GENERATED_BY_INIT
VUXO_LLM_ENABLED=false
VUXO_LLM_MODEL=qwen3:1.7b
VUXO_OBSERVABILITY_ENABLED=false
# Optional social login application IDs; mock login is available only in Development.
VUXO_MICROSOFT_CLIENT_ID=
VUXO_MICROSOFT_TENANT_ID=common
VUXO_GOOGLE_CLIENT_ID=
