FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/backend/applications/Vuxo.Api/Vuxo.Api.csproj \
    && dotnet restore src/backend/applications/Vuxo.HealthProbe/Vuxo.HealthProbe.csproj
RUN dotnet publish src/backend/applications/Vuxo.Api/Vuxo.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false
RUN dotnet publish src/backend/applications/Vuxo.HealthProbe/Vuxo.HealthProbe.csproj \
    -c Release \
    -o /app/health \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.15 AS runtime
WORKDIR /app

# No runtime apt layer. The pinned ASP.NET Core runtime runs a small,
# framework-dependent HTTP health probe without curl or extra packages.
COPY --from=build /app/publish .
COPY --from=build /app/health ./health
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
    CMD ["dotnet", "/app/health/Vuxo.HealthProbe.dll"]

USER $APP_UID
ENTRYPOINT ["dotnet", "Vuxo.Api.dll"]
