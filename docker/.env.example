VUXO_API_IMAGE=ghcr.io/keyserdsoze/vuxo-api:0.0.1
VUXO_POSTGRES_DB=vuxo
VUXO_POSTGRES_USER=vuxo
VUXO_POSTGRES_PASSWORD=CHANGE_ME
VUXO_JWT_SIGNING_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS
VUXO_ALLOWED_ORIGIN=http://localhost:5173
VUXO_CLOUDFLARE_TUNNEL_TOKEN=

# Local LLM. qwen3:1.7b is the default low-resource profile; qwen3:0.6b is the ultra-low-resource fallback.
VUXO_LLM_ENABLED=true
VUXO_LLM_MODEL=qwen3:1.7b
VUXO_LLM_TIMEOUT_SECONDS=45
VUXO_OLLAMA_IMAGE=ollama/ollama:latest

# Conservative defaults for a low-resource host. Tune only after measuring the real machine.
VUXO_OLLAMA_CONTEXT_LENGTH=4096
VUXO_OLLAMA_MAX_LOADED_MODELS=1
VUXO_OLLAMA_NUM_PARALLEL=1
VUXO_OLLAMA_MAX_QUEUE=16
VUXO_OLLAMA_KEEP_ALIVE=2m
